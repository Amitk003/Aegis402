# ===========================================
# Aegis402 Configuration
# Copy this file to .env and fill in values
# ===========================================

# Upstream API that Aegis402 will protect
UPSTREAM_URL=http://localhost:8080

# Server
PORT=3000
HOST=0.0.0.0

# Redis (optional - falls back to in-memory storage)
REDIS_URL=redis://localhost:6379

# Payment defaults
PRICE=0.05
ASSET=USDC
PAY_TO=

# Coinbase Developer Platform (optional - enables real payments)
# Get these from https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Blockchain RPC (optional - enables block confirmation polling)
# If not set, uses public RPC endpoints for known networks
RPC_URL=

# AegisSplitter contract (deployed via contracts/deploy.ts)
# Automatically splits payments: merchant gets 99.5%, Aegis402 treasury gets 0.5%
# Leave empty to skip splitting (direct payments to PAY_TO only)
SPLITTER_ADDRESS=

# Security mitigations
FINALITY_CONFIRMATIONS=2
REGISTRY_STRICT=false
FACILITATOR_ADDRESS=

# MCP (Model Context Protocol) pricing config
MCP_CONFIG_PATH=pricing.json

# Logging
# LOG_JSON=true outputs structured JSON for SIEM/log aggregators
# LOG_JSON is auto-enabled in production (NODE_ENV=production)
LOG_JSON=false

# Network selection
# Testnet:  NETWORK=eip155:84532  (Base Sepolia, default)
# Mainnet:  NETWORK=eip155:8453   (Base Mainnet - real USDC)
# Ensure PAY_TO is set to your actual wallet address on the matching network
NETWORK=eip155:84532

# Environment
NODE_ENV=development
